# ---------------------------------------------------------------------------
# RailVision AI — Environment Configuration (copy to .env)
# ---------------------------------------------------------------------------

# --- Application ---
RV_ENV=development                 # development | staging | production
RV_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
RV_API_HOST=0.0.0.0
RV_API_PORT=8000
RV_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI / Inference ---
RV_MODEL_PATH=models/weights/railvision_yolo26.pt
RV_DEVICE=auto                     # auto | cpu | cuda:0
RV_CONF_THRESHOLD=0.35
RV_IOU_THRESHOLD=0.5
RV_IMG_SIZE=640
RV_HALF_PRECISION=true             # FP16 on CUDA
RV_MAX_DET=100
RV_TRACKER=bytetrack               # bytetrack | botsort | centroid

# --- Segmentation (railway corridor) ---
RV_SEG_MODEL_PATH=models/weights/railvision_seg.pt
RV_CORRIDOR_MODE=hybrid            # geometric | model | hybrid

# --- Depth / distance calibration ---
RV_CAMERA_HEIGHT_M=3.5             # camera mounting height above rail
RV_CAMERA_FOCAL_PX=1400            # focal length in pixels (from calibration)
RV_TRACK_GAUGE_M=1.435             # standard gauge; used for scale reference

# --- Collision risk ---
RV_TRAIN_SPEED_KMH=60              # nominal train speed (fallback when no GPS)
RV_BRAKING_DISTANCE_M=800          # emergency braking distance

# --- Database ---
RV_DATABASE_URL=postgresql+asyncpg://railvision:railvision@localhost:5432/railvision
RV_REDIS_URL=redis://localhost:6379/0

# --- Storage ---
RV_STORAGE_BACKEND=local           # local | s3
RV_STORAGE_LOCAL_DIR=storage
RV_S3_ENDPOINT=http://localhost:9000
RV_S3_BUCKET=railvision-incidents
RV_S3_ACCESS_KEY=minioadmin
RV_S3_SECRET_KEY=minioadmin

# --- Alerts ---
RV_ENABLE_VOICE_ALERTS=true
RV_ALERT_COOLDOWN_S=5

# --- MLOps ---
RV_MLFLOW_TRACKING_URI=http://localhost:5000
RV_EXPERIMENT_NAME=railvision-detection

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
